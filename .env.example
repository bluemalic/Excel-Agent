# 复制本文件为 .env 并填入你自己的密钥（.env 已被 .gitignore 忽略，不会提交）
# DeepSeek 平台申请：https://platform.deepseek.com

# 必填：DeepSeek API Key（请替换为你自己的 Key，禁止提交真实密钥）
OPENAI_API_KEY=sk-your-deepseek-key
# OpenAI 兼容端点（DeepSeek）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 对话模型
OPENAI_MODEL=deepseek-flash

# 可选：模型温度与最大输出 token
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# 可选：HuggingFace 镜像（国内网络首次下载 embedding 模型用，之后可离线）
HF_ENDPOINT=https://hf-mirror.com

# 可选：Mem0 本地存储目录（相对项目根，默认 data/mem0）
# MEM0_PATH=data/mem0

# 可选：数据根目录（默认项目根下 data/）
# EXCEL_AGENT_DATA_ROOT=data
